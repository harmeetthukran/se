# Copy this file to .env and fill in your Upstox credentials.
# Create app at https://account.upstox.com/developer/apps
# The redirect URI must match EXACTLY what you registered in the Upstox app.

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5555/callback

# Leave empty; populated automatically by `python scripts/auth.py`.
# Upstox access tokens expire daily at 03:30 IST.
UPSTOX_ACCESS_TOKEN=

# Trading capital in INR (used for position sizing in backtests).
CAPITAL_INR=50000
